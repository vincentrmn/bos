# Modele des variables. Les vraies valeurs vivent dans les variables Railway
# (projet « bos ») et dans .env.local en local, jamais dans le depot.

# --- Base de donnees (Railway Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/bos
PGSSL=require

# --- Auth.js ---
AUTH_SECRET=genere-avec-openssl-rand-base64-32

# --- Adresse publique de l'application (toute URL construite cote serveur en part) ---
PUBLIC_APP_URL=http://localhost:3000
